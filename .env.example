# Copy this file to .env and fill in the keys. Never commit .env.
# Groq key (free): https://console.groq.com/keys     Gemini key (free): https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Models. Change these if a provider renames or retires one.
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/coach.db

# Soft daily audio budget shown on the dashboard (Groq free plan: 28800 audio seconds/day)
STT_DAILY_BUDGET_SEC=28800
