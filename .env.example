# PostgreSQL (required in all deployed environments)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/interview_coach?schema=public"
# Direct (non-pooled) connection, used by `prisma migrate deploy`. If you have no separate pooler, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/interview_coach?schema=public"

# Generate unique, high-entropy values. Keep these server-only.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
API_KEY_ENCRYPTION_SECRET="replace-with-a-long-random-encryption-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

BACKEND_PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# These choose models when the signed-in user has supplied that provider's key.
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_LLM_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash

# Development-only; keep false for deployment.
ALLOW_DEVELOPMENT_PROVIDER_KEYS=false
